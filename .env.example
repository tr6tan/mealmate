# Copie ce fichier en .env.local et remplis avec ta config Firebase
# (console.firebase.google.com → Ton projet → </> → Config)

VITE_FIREBASE_API_KEY=REMPLACE_MOI
VITE_FIREBASE_AUTH_DOMAIN=REMPLACE_MOI
VITE_FIREBASE_PROJECT_ID=REMPLACE_MOI
VITE_FIREBASE_STORAGE_BUCKET=REMPLACE_MOI
VITE_FIREBASE_MESSAGING_SENDER_ID=REMPLACE_MOI
VITE_FIREBASE_APP_ID=REMPLACE_MOI
# "dev" pour la branche de test, "prod" pour la production
VITE_APP_ENV=prod

# Lecture d'une recette photographiée (import par photo).
# Clé gratuite : https://aistudio.google.com/apikey
# Sans préfixe VITE_ : elle ne doit jamais atteindre le navigateur, elle n'est
# lue que par la fonction api/importer-recette.ts, côté serveur.
GEMINI_API_KEY=
